{
 "worldconfig-category-extremeweather": "极端天气",
 "worldattribute-exwBlockDestruction": "风暴破坏方块",
 "worldattribute-exwBlockDestruction-desc": "允许极端风力破坏物体：窗户碎裂、门被扯掉、茅草屋顶被撕开、树冠被撕碎、木板屋顶被雪压垮。关闭 = 你的建筑安全。",
 "worldattribute-exwDeepSnow": "深层积雪",
 "worldattribute-exwDeepSnow-desc": "降雪时积雪会远超原版深度：层层雪堆、被掩埋的植被、变白的屋顶、顺坡流动的雪。这是该模组冬季的核心。",
 "worldattribute-exwMaxSnowDepth": "最大积雪深度",
 "worldattribute-exwMaxSnowDepth-desc": "在原版表层之上最多可堆积多少完整方块的雪。",
 "worldattribute-exwMaxSnowDepth-unit": "{0} 方块",
 "worldattribute-exwSnowFlow": "雪顺坡流动",
 "worldattribute-exwSnowOnLeaves": "树冠积雪",
 "worldattribute-exwSnowCatchUp": "区块加载时补算积雪",
 "worldattribute-exwCropDamage": "天气损害作物",
 "worldattribute-exwCropDamage-desc": "允许天气杀死作物——飓风、沙尘暴侵蚀、热浪干旱——只留下枯萎的残株立在田里。关闭 = 农场安全。",
 "worldattribute-exwWeatherEvents": "自然天气事件",
 "worldattribute-exwWeatherEvents-desc": "总开关：暴风雪、季风、飓风、热浪和寒潮随季节自然发生。事件毫无预警地袭来——留意天空。关闭 = 仅保留环境天气效果。",
 "worldattribute-exwBlizzardEventChance": "暴风雪几率（冬季）",
 "worldattribute-exwBlizzardEventChance-desc": "每个符合条件的冬日（低于 -5°C）发生暴风雪的几率：数小时的大雪，风力从强劲到毁灭性不等。",
 "worldattribute-exwBlizzardEventChance-unit": "{0}%",
 "worldattribute-exwMonsoonEventChance": "季风几率（夏季）",
 "worldattribute-exwMonsoonEventChance-desc": "每个符合条件的夏日（高于 20°C）发生季风的几率：数小时的倾盆风雨。",
 "worldattribute-exwMonsoonEventChance-unit": "{0}%",
 "worldattribute-exwHurricaneFrequency": "飓风几率（冬季不会发生）",
 "worldattribute-exwHurricaneFrequency-desc": "在冬季以外且高于 10°C 时，每天发生飓风的几率：风力强到足以摧毁任何暴露在外的物体——并可能生成龙卷风。",
 "worldconfig-exwHurricaneFrequency-Off": "关闭",
 "worldconfig-exwHurricaneFrequency-Half": "0.5%（默认）",
 "worldconfig-exwHurricaneFrequency-One": "1%",
 "worldconfig-exwHurricaneFrequency-Two": "2%",
 "worldconfig-exwHurricaneFrequency-Five": "5%",
 "worldconfig-exwHurricaneFrequency-Ten": "10%",
 "worldattribute-exwHeatwaveEventChance": "热浪几率（夏季高峰）",
 "worldattribute-exwHeatwaveEventChance-desc": "当局部温度持续一整天高于 33°C 后，每天发生热浪的几率：热浪会使温度再升高 10-25°C，持续最多两天，把农田烤干。",
 "worldattribute-exwHeatwaveEventChance-unit": "{0}%",
 "worldattribute-exwColdsnapEventChance": "寒潮几率（冬季高峰）",
 "worldattribute-exwColdsnapEventChance-desc": "每个冰点以下的日子发生寒潮的几率，寒潮会使温度下降 10-25°C，持续最多两天。冬季最可能，非季节罕见。",
 "worldattribute-exwEventGraceDays": "事件之间的平静天数",
 "worldattribute-exwEventGraceDays-desc": "天气事件结束后，在这么多游戏天内不会开始新事件。天空在灾难之间总会休息。",
 "worldconfig-exwEventGraceDays-Off": "关闭",
 "worldconfig-exwEventGraceDays-1": "1 天",
 "worldconfig-exwEventGraceDays-2": "2 天",
 "worldconfig-exwEventGraceDays-3": "3 天",
 "worldconfig-exwEventGraceDays-5": "5 天",
 "worldconfig-exwEventGraceDays-7": "7 天（默认）",
 "worldconfig-exwEventGraceDays-10": "10 天",
 "worldconfig-exwEventGraceDays-14": "14 天",
 "worldattribute-exwColdsnapEventChance-unit": "{0}%",
 "worldattribute-exwModSounds": "风暴音效",
 "worldattribute-exwModSounds-desc": "此模组带来的所有声音：风暴和暴风雪循环音、呼啸的风声、房屋吱嘎声、门窗咔哒声、室内雨声、破碎和倒塌声。关闭 = 模组完全静音。",
 "worldattribute-exwModVolume": "风暴音量",
 "worldattribute-exwModVolume-desc": "此模组所有声音的全局音量。每个玩家自己的环境音设置会在此基础上叠加。",
 "worldattribute-exwModVolume-unit": "{0}%",
 "worldattribute-exwMovementSlowdown": "风暴减缓移动",
 "worldattribute-exwMovementSlowdown-desc": "顶着风暴逆风前进或在深雪中跋涉会减慢你的速度；顺风则推着你走。",
 "worldattribute-exwWindItems": "风吹动掉落物品",
 "worldattribute-exwWindItems-desc": "风暴期间，掉落的物品会在开阔地被吹向下风处。放置的方块永远不会被移动。",
 "worldattribute-exwWindShoveStrength": "风对玩家的推力",
 "worldattribute-exwWindShoveStrength-desc": "风暴风对玩家、动物和掉落物品的实际推力有多大。躲在墙后可以阻挡；潜行可以稳住身体。关闭 = 无推力。",
 "worldattribute-exwPlankAging": "雨水使木板老化",
 "worldattribute-exwPlankAging-desc": "暴露在雨中的木板方块会慢慢风化成老旧木板，最终腐烂穿透。请保持屋顶遮盖。",
 "worldattribute-exwAnimalStormEffects": "风暴影响动物",
 "worldattribute-exwAnimalStormEffects-desc": "陆地动物会像玩家一样被风暴风吹动。鱼和其他水生生物始终安全。",
 "worldattribute-exwCanopySnowBlow": "风吹落树冠积雪",
 "worldattribute-exwAvalanches": "雪崩",
 "worldattribute-exwStormSounds": "风暴音效与咔哒声",
